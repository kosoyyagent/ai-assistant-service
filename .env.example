# OpenAI-compatible backend (preferred; works with OpenAI, OpenRouter,
# DeepSeek, Ollama, vLLM, etc.). Leave empty to use Yandex or echo mode.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Yandex AI Studio (leave empty to use built-in echo mode)
YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_MODEL=aliceai-llm

# App
ADMIN_PASSWORD=change-me
SECRET_KEY=change-me
SYSTEM_PROMPT=You are a polite personal assistant.

# SQLite file location (default: ./assist.db; Docker uses /app/data/assist.db)
# DATABASE=./assist.db
